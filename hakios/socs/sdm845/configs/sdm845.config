# HakiOS fragment: the sdm845 family -- what is true of the SoC, whatever device it is in.
CONFIG_SOC="sdm845"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
# the arch timer's PPIs are 1/2/3/0 on SDM845 (Linux's sdm845.dtsi), not 13/14/11/10: the EL1 virtual timer is INTID 19
CONFIG_GIC_VTIMER=19
# the chip's own drivers (step 1 of docs/porting/index.md): the clock of the cores (the OSM, soc_cpufreq_osm=1 in soc.args),
# the temperature sensors (thermal_soc=845: the SDM845's 21) and what chip this is (SMEM at soc_smem)
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_SOCINFO=y
# no vote for the memory's bandwidth (ddr=0): run 6 (11-10) voted the most and, on the way back, 1024 for the loader, and U-Boot
# then slowed down until it stopped answering; the firmware's own vote is left as it is until a rest value is found that suits
CONFIG_DDR=0
