# HakiOS defconfig for the Xiaomi Mi MIX 2S (polaris): the common kernel, no firmware
# files, and NONE of the phone drivers for the first bare run (docs/PORTING.md:
# empty run first, drivers one at a time after). The SDM845 platform facts below
# come from sdm845.config, which is included again once drivers go in.
#include common_defconfig
#include open.config
CONFIG_DEVICE="polaris"
CONFIG_SOC="sdm845"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_GIC_VTIMER=19
