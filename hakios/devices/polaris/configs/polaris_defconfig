# HakiOS defconfig for the Xiaomi Mi MIX 2S (polaris): the common kernel, no firmware
# files, and NONE of the phone drivers for the first bare run (docs/PORTING.md:
# empty run first, drivers one at a time after). sdm845.config also turns on the
# three SoC drivers; they are switched back off below and come back one at a time.
#include common_defconfig
#include open.config
#include sdm845.config
CONFIG_DEVICE="polaris"
# CONFIG_CPUFREQ is not set
# CONFIG_THERMAL is not set
