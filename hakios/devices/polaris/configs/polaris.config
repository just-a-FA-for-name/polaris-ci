# HakiOS fragment: the Xiaomi Mi MIX 2S (polaris) -- what is true of this device and of no other.
# First-boot milestone: every phone driver left out; only the sdm845 SoC layer
# (CPUFREQ/THERMAL/SOCINFO from soc/configs/sdm845.config) is built. Drivers come
# back one at a time in the order of docs/porting/index.md step 3, each when it
# has been made to work on this phone.
# NOTE: "# CONFIG_X is not set" must occupy a whole line; trailing comments make
# the line a plain comment and the driver is built anyway.
CONFIG_DEVICE="polaris"
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_ADSP845 is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_BT3990 is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_TORCH8998 is not set
# CONFIG_HAKIOS_GPUSERVICE is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_A630 is not set
# CONFIG_HAKIOS_DSIBL is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_HAPTIC8998 is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_RMI4 is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_HIDRESOURCE is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_CELL is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_MPSS845 is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_FG8998 is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_WIFILX is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_WIFI10 is not set
