+static uint8_t
+sweet_fb_rgb10_to_u8(uint32_t value, bool wide_gamut)
+{
+	if (wide_gamut) {
+		if (value <= 384) {
+			return 0;
+		}
+		if (value >= 895) {
+			return 255;
+		}
+		return (uint8_t)(((value - 384) * 255 + 255) / 511);
+	}
+	return (uint8_t)((value * 255 + 511) / 1023);
+}
+
+static uint32_t
+sweet_fb_pixel(const SweetSurface *s, uintptr_t src, uint32_t offset, uint32_t bpr,
+    uint32_t alpha_offset, uint32_t alpha_bpr, int32_t x, int32_t y)
+{
+	if (s->pixelFormat == SWEET_FB_FORMAT_RGB10_WG ||
+	    s->pixelFormat == SWEET_FB_FORMAT_RGB10_ALPHA) {
+		uint32_t packed = *(const uint32_t *)(src + offset + (uint64_t)y * bpr + (uint64_t)x * 4);
+		bool wide = s->pixelFormat == SWEET_FB_FORMAT_RGB10_WG;
+		uint32_t r = sweet_fb_rgb10_to_u8(packed & 0x3ffu, wide);
+		uint32_t g = sweet_fb_rgb10_to_u8((packed >> 10) & 0x3ffu, wide);
+		uint32_t b = sweet_fb_rgb10_to_u8((packed >> 20) & 0x3ffu, wide);
+		uint32_t a = s->pixelFormat == SWEET_FB_FORMAT_RGB10_ALPHA ?
+		    *(const uint8_t *)(src + alpha_offset + (uint64_t)y * alpha_bpr + x) : 255;
+		return (a << 24) | (b << 16) | (g << 8) | r;
+	}
+	if (s->pixelFormat == SWEET_FB_FORMAT_LA08) {
+		const uint8_t *p = (const uint8_t *)(src + offset + (uint64_t)y * bpr + (uint64_t)x * 2);
+		return ((uint32_t)p[1] << 24) | ((uint32_t)p[0] << 16) |
+		    ((uint32_t)p[0] << 8) | p[0];
+	}
+	return 0xff000000;
+}
+
+static void
+sweet_fb_unknown_format(uint32_t format, uint32_t planes, uint32_t bpe)
+{
+	static uint32_t reported[16];
+	uint32_t key = format ^ 0x80000000u;
+	for (uint32_t value : reported) {
+		if (value == key) {
+			return;
+		}
+	}
+	for (uint32_t &value : reported) {
+		if (value == 0) {
+			value = key;
+			IOLog("SWEET FB: unsupported surface format 0x%x planes %u bpe %u; copy withheld\n",
+			    format, planes, bpe);
+			return;
+		}
+	}
+}
